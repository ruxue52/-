<!-- 晓镜书阁 · 移动盘点页 -->
<view class="container">
  <!-- 盘点单选择 -->
  <block wx:if="{{!checkId}}">
    <view class="card">
      <view class="row">
        <view class="card-title" style="margin:0">选择盘点单</view>
        <view class="spacer"></view>
        <text class="muted" bindtap="loadOrders">刷新</text>
      </view>
      <view class="order-item" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="selectOrder">
        <view class="oi-left">
          <text class="oi-no">{{item.checkNo}}</text>
          <text class="oi-sub">{{item.warehouseName || ('仓库' + item.warehouseId)}} · {{item.checkType}} · 品种 {{item.totalItems}}</text>
        </view>
        <text class="oi-status">{{item.status}}</text>
      </view>
      <view wx:if="{{orders.length === 0}}" class="muted center">暂无盘点单</view>
    </view>
  </block>

  <!-- 盘点录入 -->
  <block wx:else>
    <view class="card">
      <view class="row">
        <view class="card-title" style="margin:0">{{detail.checkNo}}</view>
        <view class="spacer"></view>
        <text class="muted" bindtap="backToList">切换单</text>
      </view>
      <view class="muted">{{detail.warehouseName || ('仓库' + detail.warehouseId)}} · 已录差异 {{diffCount}} 项 / 共 {{items.length}} 项</view>
      <button class="scan-btn mt16" bindtap="scan">📷 扫码录入</button>
      <view class="manual mt8">
        <input class="input" value="{{manualCode}}" placeholder="或输入 ISBN" bindinput="onManual" />
        <button class="btn-add" bindtap="scanManual">录入</button>
      </view>
    </view>

    <view class="card">
      <view class="card-title">盘点明细</view>
      <view class="item-row" wx:for="{{items}}" wx:key="itemId">
        <view class="it-left">
          <text class="it-name">{{item.bookName}}</text>
          <text class="it-isbn">{{item.isbn}}</text>
        </view>
        <view class="it-right">
          <text class="it-qty">账{{item.bookQty}}</text>
          <input class="it-input" type="number" value="{{item.realQty}}" data-index="{{index}}" bindinput="onQty" />
          <text class="it-diff {{item.realQty - item.bookQty !== 0 ? 'diff' : ''}}">{{item.realQty - item.bookQty}}</text>
        </view>
      </view>
      <view wx:if="{{items.length === 0}}" class="muted center">该盘点单暂无明细</view>
    </view>

    <view class="footer">
      <button class="btn-save" bindtap="saveItems">保存实盘</button>
      <button class="btn-finish" bindtap="finish">完成盘点</button>
    </view>
  </block>
</view>