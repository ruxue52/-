<view class="login-hero">
  <view class="hero-title">晓镜书阁</view>
  <view class="hero-sub">会员手机号登录 · 查积分 · 看消费记录</view>
</view>

<view class="container">
  <view class="card">
    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="请输入会员手机号"
             placeholder-class="search-placeholder" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    <view class="field">
      <text class="label">验证码</text>
      <input class="input" type="number" maxlength="6" placeholder="6 位验证码"
             placeholder-class="search-placeholder" value="{{code}}" bindinput="onCodeInput" />
      <view class="code-btn {{counting > 0 ? 'disabled' : ''}}" bindtap="sendCode">
        {{counting > 0 ? counting + 's 后重发' : '获取验证码'}}
      </view>
    </view>

    <view class="hint" wx:if="{{hint}}">{{hint}}</view>

    <view class="btn-primary {{logging ? 'disabled' : ''}}" bindtap="onLogin">登录</view>

    <view class="muted center" style="margin-top:24rpx">
      仅书店会员可登录，未办理请到门店前台登记手机号
    </view>
  </view>

  <view class="card">
    <view class="card-title">演示会员账号</view>
    <view class="demo-row" wx:for="{{demoAccounts}}"
          wx:key="*this" data-phone="{{item}}" bindtap="useDemo">
      <text>{{item}}</text>
      <view class="spacer"></view>
      <text class="muted">点击填入 ›</text>
    </view>
  </view>
</view>
